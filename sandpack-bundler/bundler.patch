index 0000000..f0ab514
--- /dev/null
+++ b/src/bundler/module-registry/semver.ts
@@ -0,0 +1,298 @@
+// Minimal npm-compatible semver range matching, enough to resolve dependency
+// ranges from an npm registry (exact versions, ^, ~, x-ranges, comparators,
+// hyphen ranges and ||). Prereleases follow npm's rule: they only match a
+// comparator set that names a prerelease of the same major.minor.patch.
+
+type Identifier = string | number;
+
+interface SemVer {
+  major: number;
+  minor: number;
+  patch: number;
+  pre: Identifier[];
+}
+
+type Operator = '<' | '<=' | '>' | '>=' | '=';
+
+interface Comparator {
+  op: Operator;
+  v: SemVer;
+}
+
+const FULL_RE = /^[v=\s]*(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?$/;
+const PARTIAL_RE = /^[v=]*(\d+|[xX*])(?:\.(\d+|[xX*]))?(?:\.(\d+|[xX*]))?(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?$/;
+
+function parsePre(pre: string | undefined): Identifier[] {
+  if (!pre) {
+    return [];
+  }
+  return pre.split('.').map((id) => (/^\d+$/.test(id) ? Number(id) : id));
+}
+
+export function parse(version: string): SemVer | null {
+  const m = version.trim().match(FULL_RE);
+  if (!m) {
+    return null;
+  }
+  return { major: +m[1], minor: +m[2], patch: +m[3], pre: parsePre(m[4]) };
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNum = typeof a === 'number';
+  const bNum = typeof b === 'number';
+  if (aNum && bNum) {
+    return (a as number) - (b as number);
+  }
+  if (aNum) {
+    return -1;
+  }
+  if (bNum) {
+    return 1;
+  }
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+export function compare(a: SemVer, b: SemVer): number {
+  const main = a.major - b.major || a.minor - b.minor || a.patch - b.patch;
+  if (main !== 0) {
+    return main;
+  }
+  if (!a.pre.length && !b.pre.length) {
+    return 0;
+  }
+  if (!a.pre.length) {
+    return 1;
+  }
+  if (!b.pre.length) {
+    return -1;
+  }
+  for (let i = 0; i < Math.max(a.pre.length, b.pre.length); i++) {
+    if (a.pre[i] === undefined) {
+      return -1;
+    }
+    if (b.pre[i] === undefined) {
+      return 1;
+    }
+    const c = compareIdentifiers(a.pre[i], b.pre[i]);
+    if (c !== 0) {
+      return c;
+    }
+  }
+  return 0;
+}
+
+function v(major: number, minor: number, patch: number, pre: Identifier[] = []): SemVer {
+  return { major, minor, patch, pre };
+}
+
+// The lowest possible prerelease of a version, used for exclusive upper bounds.
+function floor(major: number, minor: number, patch: number): SemVer {
+  return v(major, minor, patch, [0]);
+}
+
+interface Partial {
+  major: number | null;
+  minor: number | null;
+  patch: number | null;
+  pre: Identifier[];
+}
+
+function parsePartial(input: string): Partial | null {
+  const m = input.match(PARTIAL_RE);
+  if (!m) {
+    return null;
+  }
+  const num = (s: string | undefined) => (s === undefined || /^[xX*]$/.test(s) ? null : Number(s));
+  const major = num(m[1]);
+  const minor = major === null ? null : num(m[2]);
+  const patch = minor === null ? null : num(m[3]);
+  return { major, minor, patch, pre: patch === null ? [] : parsePre(m[4]) };
+}
+
+function lowerBound(p: Partial): SemVer {
+  return v(p.major ?? 0, p.minor ?? 0, p.patch ?? 0, p.pre);
+}
+
+// Exclusive upper bound of an x-range such as `1`, `1.2` or `1.2.x`.
+function xRangeUpper(p: Partial): SemVer | null {
+  if (p.major === null) {
+    return null;
+  }
+  if (p.minor === null) {
+    return floor(p.major + 1, 0, 0);
+  }
+  return floor(p.major, p.minor + 1, 0);
+}
+
+function expandToken(token: string): Comparator[] | null {
+  if (token === '' || token === '*' || token === 'x' || token === 'X') {
+    return [];
+  }
+
+  const opMatch = token.match(/^(\^|~>?|<=|>=|<|>|=)?(.*)$/)!;
+  const op = opMatch[1] ?? '';
+  const p = parsePartial(opMatch[2]);
+  if (!p) {
+    return null;
+  }
+  if (p.major === null) {
+    return op === '<' || op === '>' ? [{ op: '<', v: floor(0, 0, 0) }] : [];
+  }
+  const lower = lowerBound(p);
+
+  if (op === '^') {
+    let upper: SemVer;
+    if (p.major > 0 || p.minor === null) {
+      upper = floor(p.major + 1, 0, 0);
+    } else if (p.minor > 0 || p.patch === null) {
+      upper = floor(0, p.minor + 1, 0);
+    } else {
+      upper = floor(0, 0, p.patch + 1);
+    }
+    return [
+      { op: '>=', v: lower },
+      { op: '<', v: upper },
+    ];
+  }
+
+  if (op === '~' || op === '~>') {
+    const upper = p.minor === null ? floor(p.major + 1, 0, 0) : floor(p.major, p.minor + 1, 0);
+    return [
+      { op: '>=', v: lower },
+      { op: '<', v: upper },
+    ];
+  }
+
+  const isPartial = p.minor === null || p.patch === null;
+  if (op === '' || op === '=') {
+    if (!isPartial) {
+      return [{ op: '=', v: lower }];
+    }
+    return [
+      { op: '>=', v: lower },
+      { op: '<', v: xRangeUpper(p)! },
+    ];
+  }
+
+  if (!isPartial) {
+    return [{ op: op as Operator, v: lower }];
+  }
+  // Comparators with partial versions, e.g. `>1.2` means `>=1.3.0`.
+  switch (op) {
+    case '>':
+      return [{ op: '>=', v: xRangeUpper(p)! }];
+    case '>=':
+      return [{ op: '>=', v: lower }];
+    case '<':
+      return [{ op: '<', v: floor(lower.major, lower.minor, 0) }];
+    case '<=':
+      return [{ op: '<', v: xRangeUpper(p)! }];
+  }
+  return null;
+}
+
+function parseComparatorSet(input: string): Comparator[] | null {
+  const hyphen = input.match(/^\s*(\S+)\s+-\s+(\S+)\s*$/);
+  if (hyphen) {
+    const from = parsePartial(hyphen[1]);
+    const to = parsePartial(hyphen[2]);
+    if (!from || !to) {
+      return null;
+    }
+    const result: Comparator[] = [];
+    if (from.major !== null) {
+      result.push({ op: '>=', v: lowerBound(from) });
+    }
+    if (to.major !== null) {
+      const isPartial = to.minor === null || to.patch === null;
+      result.push(isPartial ? { op: '<', v: xRangeUpper(to)! } : { op: '<=', v: lowerBound(to) });
+    }
+    return result;
+  }
+
+  // Allow whitespace between an operator and its version, e.g. `>= 1.2.3`.
+  const tokens = input.trim().replace(/(\^|~>?|<=|>=|<|>|=)\s+/g, '$1').split(/\s+/);
+  const result: Comparator[] = [];
+  for (const token of tokens) {
+    const comparators = expandToken(token);
+    if (!comparators) {
+      return null;
+    }
+    result.push(...comparators);
+  }
+  return result;
+}
+
+function test(c: Comparator, version: SemVer): boolean {
+  const cmp = compare(version, c.v);
+  switch (c.op) {
+    case '<':
+      return cmp < 0;
+    case '<=':
+      return cmp <= 0;
+    case '>':
+      return cmp > 0;
+    case '>=':
+      return cmp >= 0;
+    case '=':
+      return cmp === 0;
+  }
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  if (!set.every((c) => test(c, version))) {
+    return false;
+  }
+  if (!version.pre.length) {
+    return true;
+  }
+  return set.some(
+    (c) =>
+      c.v.pre.length > 0 &&
+      c.v.major === version.major &&
+      c.v.minor === version.minor &&
+      c.v.patch === version.patch
+  );
+}
+
+/** Returns the comparator sets of a range, or null if the range is not valid. */
+export function parseRange(range: string): Comparator[][] | null {
+  const sets: Comparator[][] = [];
+  for (const part of range.split('||')) {
+    const set = parseComparatorSet(part);
+    if (!set) {
+      return null;
+    }
+    sets.push(set);
+  }
+  return sets;
+}
+
+export function satisfies(version: string, range: string): boolean {
+  const parsed = parse(version);
+  const sets = parseRange(range);
+  if (!parsed || !sets) {
+    return false;
+  }
+  return sets.some((set) => testSet(set, parsed));
+}
+
+export function maxSatisfying(versions: string[], range: string): string | null {
+  const sets = parseRange(range);
+  if (!sets) {
+    return null;
+  }
+  let best: SemVer | null = null;
+  let bestRaw: string | null = null;
+  for (const raw of versions) {
+    const parsed = parse(raw);
+    if (!parsed || !sets.some((set) => testSet(set, parsed))) {
+      continue;
+    }
+    if (!best || compare(parsed, best) > 0) {
+      best = parsed;
+      bestRaw = raw;
+    }
+  }
+  return bestRaw;
+}
