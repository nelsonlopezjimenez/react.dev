diff --git a/src/bundler/module-registry/npm-registry.ts b/src/bundler/module-registry/npm-registry.ts
new file mode 100644
index 0000000..272eece
--- /dev/null
+++ b/src/bundler/module-registry/npm-registry.ts
@@ -0,0 +1,180 @@
+// Resolves and downloads packages from an npm registry mirror instead of the
+// CodeSandbox package CDN. The mirror is served next to the bundler, under
+// /registry on the same origin, by sandpack-bundler/serve.mjs in react.dev.
+
+import { retryFetch } from '../../utils/fetch';
+import { maxSatisfying, satisfies } from './semver';
+
+export const REGISTRY_URL = `${self.location.origin}/registry`;
+
+interface PackageVersion {
+  version: string;
+  dependencies?: Record<string, string>;
+  optionalDependencies?: Record<string, string>;
+  peerDependencies?: Record<string, string>;
+  peerDependenciesMeta?: Record<string, { optional?: boolean }>;
+}
+
+interface Packument {
+  name: string;
+  'dist-tags'?: Record<string, string>;
+  versions: Record<string, PackageVersion>;
+}
+
+export interface ResolvedPackage {
+  name: string;
+  version: string;
+  depth: number;
+}
+
+const packuments: Map<string, Promise<Packument>> = new Map();
+const packageFiles: Map<string, Map<string, string>> = new Map();
+const packageDownloads: Map<string, Promise<Map<string, string>>> = new Map();
+
+function packumentURL(name: string): string {
+  // Scoped packages are requested as `@scope%2fname`, like the npm CLI does.
+  return `${REGISTRY_URL}/${name.replace('/', '%2f')}`;
+}
+
+export function fetchPackument(name: string): Promise<Packument> {
+  let promise = packuments.get(name);
+  if (!promise) {
+    promise = retryFetch(packumentURL(name), {
+      // Ask for the smaller "abbreviated" metadata, falling back to the full document.
+      headers: { Accept: 'application/vnd.npm.install-v1+json; q=1.0, application/json; q=0.8, */*' },
+      maxRetries: 3,
+    })
+      .then((res) => res.json() as Promise<Packument>)
+      .catch((err) => {
+        packuments.delete(name);
+        throw new Error(
+          `Could not load package "${name}" from ${REGISTRY_URL}. If it's missing from the package mirror, run \`yarn sandpack:mirror\`. ${
+            err?.message ?? err
+          }`
+        );
+      });
+    packuments.set(name, promise);
+  }
+  return promise;
+}
+
+export function resolveVersion(packument: Packument, spec: string): string {
+  const { name, versions } = packument;
+  const tags = packument['dist-tags'] ?? {};
+  const range = spec.trim();
+  if (range === '' || range === '*') {
+    if (tags.latest && versions[tags.latest]) {
+      return tags.latest;
+    }
+  }
+  if (tags[range] && versions[tags[range]]) {
+    return tags[range];
+  }
+  if (versions[range]) {
+    return range;
+  }
+  if (/^(npm:|file:|link:|git|https?:|github:)/.test(range) || range.includes('/')) {
+    throw new Error(`Unsupported version "${spec}" for "${name}": only versions, ranges and dist-tags work`);
+  }
+  // Like npm, prefer the `latest` tag when it satisfies the range.
+  if (tags.latest && versions[tags.latest] && satisfies(tags.latest, range)) {
+    return tags.latest;
+  }
+  const version = maxSatisfying(Object.keys(versions), range);
+  if (!version) {
+    throw new Error(
+      `No version of "${name}" in ${REGISTRY_URL} matches "${spec}". To add it to the package mirror, run \`yarn sandpack:mirror\`.`
+    );
+  }
+  return version;
+}
+
+/**
+ * Resolves dependency ranges to a flat list of packages, breadth first.
+ * Like the CDN it replaces, it installs a single version of every package:
+ * the one closest to the root wins.
+ */
+export async function resolveDependencies(deps: Record<string, string>): Promise<ResolvedPackage[]> {
+  const resolved: Map<string, ResolvedPackage> = new Map();
+  let level: Array<[string, string]> = Object.entries(deps);
+  let depth = 0;
+
+  while (level.length) {
+    const next: Array<[string, string]> = [];
+    await Promise.all(
+      level.map(async ([name, spec]) => {
+        if (resolved.has(name)) {
+          return;
+        }
+        const entry: ResolvedPackage = { name, version: '', depth };
+        resolved.set(name, entry);
+
+        const packument = await fetchPackument(name);
+        entry.version = resolveVersion(packument, spec);
+        const pkg = packument.versions[entry.version];
+
+        const optional = pkg.optionalDependencies ?? {};
+        for (const [dep, range] of Object.entries(pkg.dependencies ?? {})) {
+          if (!(dep in optional)) {
+            next.push([dep, range]);
+          }
+        }
+        for (const [dep, range] of Object.entries(pkg.peerDependencies ?? {})) {
+          if (!pkg.peerDependenciesMeta?.[dep]?.optional) {
+            next.push([dep, range]);
+          }
+        }
+      })
+    );
+    level = next;
+    depth++;
+  }
+
+  return Array.from(resolved.values());
+}
+
+// A package as prepared by the mirror (sandpack-bundler/mirror.mjs in
+// react.dev). JavaScript files are already CommonJS, and `deps` lists the
+// require() specifiers of each one, so the browser doesn't run Babel on them.
+interface PreparedPackage {
+  files: Record<string, string>;
+  deps: Record<string, string[]>;
+}
+
+const precompiledDeps: Map<string, string[]> = new Map();
+
+function preparedPackageURL(name: string, version: string): string {
+  return `${REGISTRY_URL}/${name}/-/${name.split('/').pop()}-${version}.json`;
+}
+
+/** Downloads a package. Its files are then available through getPackageFile. */
+export function fetchPackageFiles(name: string, version: string): Promise<Map<string, string>> {
+  const key = `${name}@${version}`;
+  let promise = packageDownloads.get(key);
+  if (!promise) {
+    promise = (async () => {
+      const response = await retryFetch(preparedPackageURL(name, version), { maxRetries: 3 });
+      const prepared = (await response.json()) as PreparedPackage;
+      const files: Map<string, string> = new Map(Object.entries(prepared.files));
+      for (const [path, deps] of Object.entries(prepared.deps)) {
+        precompiledDeps.set(`/node_modules/${name}/${path}`, deps);
+      }
+      packageFiles.set(key, files);
+      return files;
+    })().catch((err) => {
+      packageDownloads.delete(key);
+      throw new Error(`Could not download ${key} from ${REGISTRY_URL}: ${err?.message ?? err}`);
+    });
+    packageDownloads.set(key, promise);
+  }
+  return promise;
+}
+
+export function getPackageFile(name: string, version: string, path: string): string | undefined {
+  return packageFiles.get(`${name}@${version}`)?.get(path);
+}
+
+/** The require() specifiers of a precompiled package file, or undefined if it needs transpiling. */
+export function getPrecompiledDeps(filepath: string): string[] | undefined {
+  return precompiledDeps.get(filepath);
+}
